[Unit]
Description=Avalon Zero-Touch Ops Daemon
After=network.target

[Service]
Type=oneshot
ExecStart=/usr/bin/env python3 /home/lord-mahonheim/bifrost/tesla/tools/avalon_ops_daemon.py
RestartSec=5
