{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Loop Trace",
  "description": "Schéma canonique pour la télémétrie de la boucle d'exécution SIA-TESLA-H",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "description": "Identifiant unique de l'exécution globale (ex: UUID)"
    },
    "task_id": {
      "type": "string",
      "description": "Identifiant de la tâche de référence (ex: T-001)"
    },
    "agent_id": {
      "type": "string",
      "description": "Nom du sous-agent invoqué (ex: tesla-master-code)"
    },
    "phase": {
      "type": "string",
      "enum": ["PLANNING", "EXECUTION", "VERIFICATION", "FALLBACK"],
      "description": "Phase de la boucle d'exécution"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "action_type": {
      "type": "string",
      "enum": ["skill", "tool", "mcp", "native"],
      "description": "Type d'action exécutée"
    },
    "capability": {
      "type": "string",
      "description": "Nom spécifique de la capacité utilisée (ex: lsp_diagnostics)"
    },
    "status": {
      "type": "string",
      "enum": ["SUCCESS", "FAIL", "RETRY", "ESCALATE"]
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "token_usage": {
      "type": "object",
      "properties": {
        "input": { "type": "integer", "minimum": 0 },
        "output": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      },
      "required": ["input", "output", "total"]
    },
    "errors": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Liste des messages d'erreur rencontrés"
    },
    "lsp_diagnostics": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Erreurs remontées par le LSP"
    },
    "artifacts": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Fichiers ou livrables générés"
    }
  },
  "required": [
    "run_id",
    "task_id",
    "agent_id",
    "phase",
    "timestamp",
    "action_type",
    "capability",
    "status",
    "duration_ms",
    "token_usage"
  ]
}
