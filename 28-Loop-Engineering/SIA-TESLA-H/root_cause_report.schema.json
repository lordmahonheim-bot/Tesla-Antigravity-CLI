{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Root Cause Report",
  "type": "object",
  "properties": {
    "rca_id": { "type": "string" },
    "run_id": { "type": "string" },
    "taxonomy": {
      "type": "string",
      "enum": ["PROMPT", "SKILL", "TOOL", "GOVERNANCE", "ENVIRONMENT"]
    },
    "description": { "type": "string" },
    "impact_assessment": { "type": "string" },
    "proposed_fix_direction": { "type": "string" }
  },
  "required": ["rca_id", "run_id", "taxonomy", "description", "proposed_fix_direction"]
}
