{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Arena Report",
  "type": "object",
  "properties": {
    "arena_run_id": { "type": "string" },
    "patch_id": { "type": "string" },
    "fitness_score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "baseline_comparison": {
      "type": "object",
      "properties": {
        "lsp_errors_diff": { "type": "integer" },
        "token_usage_diff": { "type": "integer" },
        "success_rate_diff": { "type": "integer" }
      }
    },
    "security_violations": { "type": "integer" },
    "conclusion": { "type": "string", "enum": ["PASS", "FAIL"] }
  },
  "required": ["arena_run_id", "patch_id", "fitness_score", "security_violations", "conclusion"]
}
