{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Gate Decision",
  "type": "object",
  "properties": {
    "decision_id": { "type": "string" },
    "patch_id": { "type": "string" },
    "decision": { "type": "string", "enum": ["MERGE", "REJECT", "ESCALATE_TO_MAHONHEIM"] },
    "gatekeeper": { "type": "string" },
    "reason": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" }
  },
  "required": ["decision_id", "patch_id", "decision", "gatekeeper"]
}
