{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Patch Proposal",
  "type": "object",
  "properties": {
    "patch_id": { "type": "string" },
    "rca_id": { "type": "string" },
    "target_file": { "type": "string" },
    "diff": { "type": "string" },
    "patch_class": {
      "type": "string",
      "enum": ["MINOR", "STANDARD", "MAJOR", "CRITICAL"]
    },
    "estimated_tokens_change": { "type": "integer" }
  },
  "required": ["patch_id", "rca_id", "target_file", "diff", "patch_class"]
}
