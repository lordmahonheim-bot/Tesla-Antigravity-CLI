#!/bin/bash
# agy-smart — Wrapper intelligent pour Antigravity CLI avec filtrage sémantique RAG local
set -e

# Détermination des chemins physiques
PROJ_DIR=$(pwd)
SCRIPT_DIR=$(dirname "$(readlink -f "$0")")

INDEXER_SCRIPT="$SCRIPT_DIR/agy_indexer.py"
FOCUS_SCRIPT="$SCRIPT_DIR/agy_focus.py"
CACHE_DIR="$PROJ_DIR/.agy_cache"

if [ -z "$1" ]; then
    echo "Usage: ./agy-smart \"Votre question complexe sur le projet\""
    exit 1
fi

QUERY="$1"

# Résolution de l'exécutable Python (.venv local prioritaire)
if [ -f "$PROJ_DIR/.venv/bin/python3" ]; then
    PYTHON_EXE="$PROJ_DIR/.venv/bin/python3"
elif [ -f "$SCRIPT_DIR/../.venv/bin/python3" ]; then
    PYTHON_EXE="$SCRIPT_DIR/../.venv/bin/python3"
else
    PYTHON_EXE="python3"
fi

# Déclenchement automatique de l'indexation initiale si le cache est manquant
if [ ! -d "$CACHE_DIR" ]; then
    echo "[*] Cache local .agy_cache inexistant. Lancement de l'indexation sémantique..."
    "$PYTHON_EXE" "$INDEXER_SCRIPT" "$PROJ_DIR"
fi

# Étape 1 : Filtrage sémantique local de la requête
echo "[*] Étape 1 : Focalisation du contexte sémantique..."
"$PYTHON_EXE" "$FOCUS_SCRIPT" "$QUERY" "$PROJ_DIR" 5

# Étape 2 : Exécution d'Antigravity CLI native (agy) sur le contexte isolé
echo "[*] Étape 2 : Délégation à Antigravity CLI (agy) sur le périmètre focalisé..."
if command -v agy &> /dev/null; then
    agy --add-dir /tmp/agy_ctx --print "$QUERY"
else
    # Fallback pour compatibilité en local si agy n'est pas dans le PATH global mais dans .local/bin
    if [ -f "$HOME/.local/bin/agy" ]; then
        "$HOME/.local/bin/agy" --add-dir /tmp/agy_ctx --print "$QUERY"
    else
        echo "[-] Erreur : Antigravity CLI (agy) introuvable dans le PATH."
        exit 1
    fi
fi
