# Separate config: never overwrite ~/.config/terminator/config.
# Start from the repository root, without GEMINI_API_KEY in the parent env.
[global_config]
  dbus = False
[keybindings]
[profiles]
  [[default]]
    scrollback_lines = 2000
    scrollback_infinite = False
    use_system_font = False
    font = Monospace 11
[layouts]
  [[tesla-headless]]
    [[[window0]]]
      type = Window
      parent = ""
    [[[columns]]]
      type = HPaned
      parent = window0
    [[[left]]]
      type = VPaned
      parent = columns
      order = 0
    [[[editor]]]
      type = Terminal
      parent = left
      order = 0
      profile = default
    [[[git]]]
      type = Terminal
      parent = left
      order = 1
      profile = default
    [[[ai]]]
      type = Terminal
      parent = columns
      order = 1
      profile = default
[plugins]
