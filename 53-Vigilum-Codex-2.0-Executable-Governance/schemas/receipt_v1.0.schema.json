{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TeslaSubagentReceipt",
  "type": "object",
  "required": [
    "receipt_version",
    "mission_id",
    "node_id",
    "agent_id",
    "status",
    "output_artifacts",
    "submitted_at",
    "invocation_id",
    "started_at",
    "finished_at",
    "output_manifest_sha256",
    "executor_attestation",
    "transcript_ref"
  ],
  "properties": {
    "receipt_version": { "type": "string" },
    "mission_id": { "type": "string" },
    "node_id": { "type": "string" },
    "agent_id": { "type": "string" },
    "status": { "type": "string", "enum": ["SUCCESS", "COMPLETED", "FAILED"] },
    "output_artifacts": { "type": "array", "items": { "type": "string" } },
    "submitted_at": { "type": "string" },
    "invocation_id": { "type": "string", "pattern": "^inv-[A-Za-z0-9-]{8,64}$" },
    "started_at": { "type": "string" },
    "finished_at": { "type": "string" },
    "output_manifest_sha256": { "type": "string" },
    "executor_attestation": { "type": "string" },
    "transcript_ref": { "type": "string" },
    "exit_code": { "type": "integer" },
    "tool_invocations_count": { "type": "integer" }
  },
  "additionalProperties": false
}
